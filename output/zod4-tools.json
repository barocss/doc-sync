{
  "tools": [
    {
      "name": "get_schema",
      "description": "Read the configured schema and whether the connected server verified its version.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_server_schema",
      "description": "Read the authoritative server schema and its version, including after a schema transition.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "recovery_status",
      "description": "Inspect a durable unresolved edit and any exact server receipt. Unknown never means rejected. No edit is sent by this tool.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "upgrade_schema",
      "description": "Install the current server schema when compatible and reconnect. Pending changes and this actor's history are preserved. Resolve an unconfirmed conditional edit first.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "transition_schema",
      "description": "Request a compatible schema transition using an exact server epoch, sequence and schema version. Network failure leaves the outcome unknown; inspect get_server_schema before retrying.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "base": {
            "type": "object",
            "properties": {
              "epoch": {
                "type": "string",
                "minLength": 1
              },
              "serverSeq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "schemaVersion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "epoch",
              "serverSeq",
              "schemaVersion"
            ],
            "additionalProperties": false
          },
          "schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "base",
          "schema"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "read_document",
      "description": "Read the local replica, revision, and pending changes. Remote changes may still be in transit.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "read_document_slice",
      "description": "Read bounded canonical model children from this local replica. Paths are child indexes. Covered table-cell data is retained, as in read_document. Use nextCursor alone for the next page; any document/revision change invalidates it. Direct row/cell slicing is unsupported; target a cell body at [table,row,col,0]. maxBytes bounds successful MCP tool-result JSON including text/structuredContent duplication; JSON-RPC frames and transport headers are excluded.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxNodes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "maxTextUnits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144
          },
          "cursor": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "set_presence",
      "description": "Publish the agent's actual caret or selection in the current document. Use the revision from read_document; anchor is the active end and focus is the other end. Pass null endpoints to hide. Presence is transient and delivery is unconfirmed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "base": {
            "type": "object",
            "properties": {
              "epoch": {
                "type": "string",
                "minLength": 1
              },
              "serverSeq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "schemaVersion": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "epoch",
              "serverSeq",
              "schemaVersion"
            ],
            "additionalProperties": false
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "anchor": {
            "anyOf": [
              {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "focus": {
            "anyOf": [
              {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "character": {
            "type": "string",
            "enum": [
              "cat",
              "fox",
              "owl",
              "robot"
            ]
          },
          "expression": {
            "type": "string",
            "enum": [
              "thinking",
              "editing",
              "happy",
              "concerned",
              "curious",
              "focused",
              "surprised"
            ]
          },
          "activity": {
            "type": "string",
            "enum": [
              "reading",
              "thinking",
              "editing",
              "done",
              "needs_attention"
            ]
          }
        },
        "required": [
          "base",
          "name",
          "color",
          "anchor",
          "focus"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "edit_document",
      "description": "Apply model edits only if the server atomically confirms the revision from read_document. On an unconfirmed result call retry_edit, not edit_document again.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "base": {
            "type": "object",
            "properties": {
              "epoch": {
                "type": "string",
                "minLength": 1
              },
              "serverSeq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "schemaVersion": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "epoch",
              "serverSeq",
              "schemaVersion"
            ],
            "additionalProperties": false
          },
          "edits": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "insert"
                    },
                    "at": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "content": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "op",
                    "at",
                    "content"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "delete"
                    },
                    "at": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "op",
                    "at",
                    "count"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "update"
                    },
                    "at": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "attrs": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "length": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "op",
                    "at",
                    "attrs"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "split"
                    },
                    "at": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "required": [
                    "op",
                    "at"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "merge"
                    },
                    "at": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "required": [
                    "op",
                    "at"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "move"
                    },
                    "from": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "at": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "required": [
                    "op",
                    "from",
                    "at"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "stepId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "base",
          "edits"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "retry_edit",
      "description": "Resolve an unconfirmed conditional edit by retrying the exact same request. Do not submit a new edit until it is resolved.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "discard_history",
      "description": "Permanently discard this participant's undo and redo history and release its old recovery reservation. Pending or uncertain edits block this operation; other participants' edits are preserved.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "destructiveHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "undo",
      "description": "undo the AI participant's own history in this running session. Other participants' changes follow the existing collaboration rules.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "redo",
      "description": "redo the AI participant's own history in this running session. Other participants' changes follow the existing collaboration rules.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}