{
  "name": "doc-sync-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "benchmarks"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @doc-sync/demo --",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "npm run bench --workspace @doc-sync/benchmarks --",
    "bench:client": "npm run client --workspace @doc-sync/benchmarks --",
    "docs:dev": "npm run dev --workspace @doc-sync/docs --",
    "docs:build": "npm run build --workspace @doc-sync/docs",
    "docs:preview": "npm run preview --workspace @doc-sync/docs --",
    "docs:check": "npm run check:build --workspace @doc-sync/docs",
    "dev:products": "node apps/demo/products/start.mjs",
    "dev:local": "node apps/demo/local/start.mjs",
    "check:local": "node apps/demo/local/check-browser.mjs",
    "check:local:shared": "node apps/demo/local/check-shared-browser.mjs",
    "dev:client": "node apps/demo/client/start.mjs",
    "check:client": "node apps/demo/client/check-browser.mjs",
    "bench:client-api": "node benchmarks/client-api.mjs",
    "build": "node scripts/build-packages.mjs",
    "pretest": "npm run build",
    "pretypecheck": "npm run build",
    "check:packages": "npm run build && node scripts/check-package-artifacts.mjs",
    "predev": "npm run build",
    "predocs:build": "npm run build",
    "predev:products": "npm run build",
    "predev:local": "npm run build",
    "predev:client": "npm run build",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "check:release": "node scripts/check-release-preparation.mjs",
    "dev:graphic": "node apps/demo/graphic/start.mjs",
    "predev:graphic": "npm run build",
    "check:graphic": "node apps/demo/graphic/check-browser.mjs",
    "bench:graphic": "node apps/demo/graphic/check-performance.mjs",
    "dev:spreadsheet": "node apps/demo/spreadsheet/start.mjs",
    "predev:spreadsheet": "npm run build",
    "check:spreadsheet": "node apps/demo/spreadsheet/check-browser.mjs",
    "bench:spreadsheet": "node apps/demo/spreadsheet/check-performance.mjs",
    "dev:presence": "node apps/demo/presence/start.mjs",
    "predev:presence": "npm run build",
    "check:presence": "node apps/demo/presence/check-browser.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@visactor/vtable": {
      "lodash": "4.18.1",
      "minimist": "1.2.8"
    }
  }
}
