{
  "word": {
    "root": "word-document",
    "marks": [
      "bold",
      "italic",
      "underline",
      "strike",
      "code"
    ],
    "markValues": {
      "link": {
        "default": "",
        "pattern": "^(https?://\\S+)?$"
      },
      "color": {
        "default": "",
        "inherit": true
      },
      "fontSize": {
        "default": 12,
        "min": 8,
        "max": 128,
        "inherit": true
      }
    },
    "nodes": {
      "paragraph": {
        "shape": "text",
        "children": [
          "link",
          "mention",
          "inline-image"
        ],
        "attrs": {
          "style": {
            "default": {
              "align": "left",
              "spacing": 1,
              "indent": 0
            },
            "fields": {
              "align": {
                "default": "left",
                "values": [
                  "left",
                  "center",
                  "right",
                  "justify"
                ]
              },
              "spacing": {
                "default": 1,
                "min": 0.5,
                "max": 4
              },
              "indent": {
                "default": 0,
                "min": 0,
                "max": 12
              }
            }
          }
        }
      },
      "heading1": {
        "shape": "text",
