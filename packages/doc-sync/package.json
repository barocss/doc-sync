{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "name": "@barocss/doc-sync",
  "description": "Compatibility facade for DocSync core and independent editor bindings",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js",
      "default": "./dist/sync.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./prosemirror": {
      "types": "./dist/prosemirror.d.ts",
      "import": "./dist/prosemirror.js",
      "default": "./dist/prosemirror.js"
    },
    "./tiptap": {
      "types": "./dist/tiptap.d.ts",
      "import": "./dist/tiptap.js",
      "default": "./dist/tiptap.js"
    },
    "./slate": {
      "types": "./dist/slate.d.ts",
      "import": "./dist/slate.js",
      "default": "./dist/slate.js"
    },
    "./lexical": {
      "types": "./dist/lexical.d.ts",
      "import": "./dist/lexical.js",
      "default": "./dist/lexical.js"
    }
  },
  "dependencies": {
    "@barocss/doc-sync-core": ">=0.0.0 <0.1.0"
  },
  "peerDependencies": {
    "@barocss/doc-sync-prosemirror": ">=0.0.0 <0.1.0",
    "@barocss/doc-sync-tiptap": ">=0.0.0 <0.1.0",
    "@barocss/doc-sync-slate": ">=0.0.0 <0.1.0",
    "@barocss/doc-sync-lexical": ">=0.0.0 <0.1.0"
  },
  "peerDependenciesMeta": {
    "@barocss/doc-sync-prosemirror": {
      "optional": true
    },
    "@barocss/doc-sync-tiptap": {
      "optional": true
    },
    "@barocss/doc-sync-slate": {
      "optional": true
    },
    "@barocss/doc-sync-lexical": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lexical/rich-text": "0.52.0",
    "@lexical/table": "0.52.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0",
    "lexical": "0.52.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "slate": "0.146.0"
  }
}
