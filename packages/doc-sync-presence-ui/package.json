{
  "name": "@barocss/doc-sync-presence-ui",
  "description": "Optional framework-free DocSync presence views",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@barocss/doc-sync": ">=0.0.0 <0.1.0"
  },
  "peerDependenciesMeta": {
    "@barocss/doc-sync": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
