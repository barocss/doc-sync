      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@barocss/doc-sync-core": ">=0.0.0 <0.1.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@barocss/doc-sync-prosemirror": ">=0.0.0 <0.1.0"
